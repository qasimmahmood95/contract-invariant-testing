#!/bin/sh
# Pre-commit gate for contract-invariant-testing.
#
# Enable with:  git config core.hooksPath .githooks
#
# Both checks are cheap enough to run on every commit.

set -e

if command -v gitleaks >/dev/null 2>&1; then
  echo "· gitleaks (staged changes)"
  # --staged scans what is about to be committed, which is the only thing this
  # hook can still prevent. Full history is scanned separately in CI.
  gitleaks protect --staged --config .gitleaks.toml --redact --no-banner
else
  echo "⚠ gitleaks not installed — skipping local secret scan (CI still enforces it)"
  echo "  install: https://github.com/gitleaks/gitleaks#installing"
fi

if command -v forge >/dev/null 2>&1; then
  echo "· forge fmt (check)"
  forge fmt --check
fi
